# Shared look of every terminal scene: 1920x1080, font 26 (about 106 columns, so the CLI never wraps), high contrast, prompt `$ `.
# Sourced by the scene tapes; the hub computer uses this dark theme, the agent computer overrides it.
Set Shell bash
Set Width 1920
Set Height 1080
Set FontSize 26
Set LineHeight 1.25
Set Padding 48
Set Framerate 30
Set TypingSpeed 55ms
Set CursorBlink false
Set WindowBar Colorful
Set Theme "Catppuccin Mocha"
