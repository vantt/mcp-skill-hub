{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/distill.schema.json",
  "title": "Skill distillation document",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "cursors", "lessons"],
  "properties": {
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "purpose", "in_scope", "out_of_scope", "failures_it_prevents"],
      "properties": {
        "status": {
          "enum": ["draft", "confirmed"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "failures_it_prevents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    "cursors": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{7,40}$"
      },
      "minProperties": 1
    },
    "coverage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "read": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "not_read": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "layer", "what", "notable", "where", "contrast", "score", "decision"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "layer": {
            "enum": ["enforcement", "content", "history", "validation", "craft", "wording", "ecosystem"]
          },
          "what": {
            "type": "string",
            "minLength": 1
          },
          "notable": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+@[0-9a-f]{7,40}(?::[^#\\s]+(?:#L\\d+(?:-L\\d+)?)?)?$"
            },
            "minItems": 1
          },
          "contrast": {
            "enum": ["new", "extends", "contradicts", "already-covered"]
          },
          "score": {
            "type": "object",
            "additionalProperties": false,
            "required": ["relevance", "facts", "impact", "evidence", "effort", "why"],
            "properties": {
              "relevance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "facts": {
                "type": "array",
                "items": {
                  "enum": ["a", "b", "c", "d", "e"]
                },
                "uniqueItems": true
              },
              "impact": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              },
              "evidence": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "effort": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "why": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "final_score": {
            "type": "number"
          },
          "also_fits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(hub|new-skill:[a-z0-9-]+|[a-z0-9]+(?:-[a-z0-9]+)*)$"
            }
          },
          "status": {
            "type": "string",
            "pattern": "^(removed|superseded-by:[a-z0-9-]+)$"
          },
          "found_by": {
            "const": "human"
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state"],
            "properties": {
              "state": {
                "enum": ["candidate", "planned", "ported", "rejected"]
              },
              "reason": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
