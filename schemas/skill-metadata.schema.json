{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/skill-metadata.schema.json",
  "title": "Curated skill metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "status", "description", "routing"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "name": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "deprecated", "archived"]},
    "description": {"type": "string", "minLength": 1},
    "collection_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "collection": {"type": ["string", "array"]},
    "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "domain": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "topics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "technologies": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "content": {"type": "object"},
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "not_for": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "min_scope": {"enum": ["", "single_step", "multi_step", "project"]},
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "facts": {"$ref": "#/$defs/factRequirements"},
            "capabilities": {"$ref": "#/$defs/capabilityRequirements"}
          }
        },
        "boosts": {"type": "object"},
        "distinguish_from": {"type": "array", "items": {"$ref": "#/$defs/distinguishRelationship"}},
        "supporting": {"type": "array", "items": {"$ref": "#/$defs/supportRelationship"}},
        "equivalent_to": {"type": "array", "items": {"$ref": "#/$defs/equivalentRelationship"}, "uniqueItems": true},
        "examples": {"$ref": "#/$defs/routingExamples"},
        "counter_examples": {"$ref": "#/$defs/routingExamples"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bins": {"type": "array", "items": {"$ref": "#/$defs/runtimeBin"}},
            "env": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"}, "uniqueItems": true},
            "platforms": {"type": "array", "items": {"enum": ["linux", "darwin", "windows", "freebsd"]}, "uniqueItems": true}
          }
        },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": {"$ref": "#/$defs/runtimeCommand"},
            "check": {"$ref": "#/$defs/runtimeCommand"}
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewed": {"type": "boolean"},
        "curated": {"type": "boolean"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "routing_review_rationale": {"type": "string", "minLength": 1},
        "content_reviewed_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "created_by": {"type": "string"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "revision": {"type": "string"},
        "path": {"type": "string"},
        "origin": {"$ref": "#/$defs/origin"}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "occurred_at"],
        "properties": {
          "from": {"enum": ["draft", "active", "deprecated"]},
          "state": {"enum": ["draft", "active", "deprecated", "archived"]},
          "occurred_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "routingExamples": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 300, "pattern": "\\S"}, "uniqueItems": true},
    "runtimeBinName": {"type": "string", "pattern": "^[A-Za-z0-9._+-]{1,64}$"},
    "runtimeBin": {
      "oneOf": [
        {"$ref": "#/$defs/runtimeBinName"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"$ref": "#/$defs/runtimeBinName"},
            "version": {"type": "string", "pattern": "^(>=|>|<=|<|=)?\\s*\\d+(\\.\\d+){0,2}$"}
          }
        }
      ]
    },
    "runtimeCommand": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\r\\n]*\\S[^\\r\\n]*$"},
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["github", "git", "local"]},
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^([a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)(/[a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*)*$"},
        "name": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]*[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$"},
        "folder_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "files_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "added_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "local"}}},
          "then": {
            "not": {"required": ["repository"]}
          }
        }
      ]
    },
    "factRequirement": {"type": "object", "additionalProperties": false, "required": ["key", "value"], "properties": {"key": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}},
    "factRequirements": {"type": "object", "additionalProperties": false, "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/factRequirement"}}, "any": {"type": "array", "items": {"$ref": "#/$defs/factRequirement"}}}},
    "capabilityRequirements": {"type": "object", "additionalProperties": false, "properties": {"all": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "any": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "distinguishRelationship": {"type": "object", "additionalProperties": false, "required": ["skill", "discriminator"], "properties": {"skill": {"type": "string"}, "discriminator": {"type": "object", "additionalProperties": false, "required": ["field", "question", "choices"], "properties": {"field": {"type": "string", "minLength": 1}, "question": {"type": "string", "minLength": 1}, "choices": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}}},
    "supportRelationship": {"type": "object", "additionalProperties": false, "required": ["skill", "when", "role", "activation"], "properties": {"skill": {"type": "string", "minLength": 1}, "when": {"type": "object", "additionalProperties": false, "required": ["operation"], "properties": {"operation": {"enum": ["explore", "design", "implement", "review", "debug", "test", "refactor", "migrate", "document", "operate", "research", "other"]}}}, "role": {"enum": ["validation", "research", "implementation", "review", "documentation", "operations"]}, "activation": {"enum": ["on-demand"]}}},
    "equivalentRelationship": {"type": "object", "additionalProperties": false, "required": ["skill", "preference", "version_policy"], "properties": {"skill": {"type": "string", "minLength": 1}, "preference": {"enum": ["self", "target"]}, "version_policy": {"enum": ["exact", "compatible", "latest-reviewed"]}}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
      "then": {
        "properties": {
          "routing": {
            "required": ["triggers", "not_for", "min_scope"],
            "properties": {
              "triggers": {"minItems": 1},
              "min_scope": {"enum": ["single_step", "multi_step", "project"]}
            }
          }
        }
      }
    }
  ]
}
