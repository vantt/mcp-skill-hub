{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/recommendation-policy-v1.schema.json",
  "title": "Deterministic recommendation policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "normalization_version", "weights", "thresholds", "extensions"],
  "properties": {
    "schema_version": {"const": 1}, "policy_version": {"type": "string", "minLength": 1}, "normalization_version": {"const": "fts-rules-v1"},
    "weights": {"type": "object", "additionalProperties": false, "required": ["lexical", "trigger", "artifact", "fact", "operation", "quality", "not_for_penalty", "constraint_penalty", "scope_penalty"], "properties": {"lexical": {"type": "number"}, "trigger": {"type": "number"}, "artifact": {"type": "number"}, "fact": {"type": "number"}, "operation": {"type": "number"}, "quality": {"type": "number"}, "not_for_penalty": {"type": "number"}, "constraint_penalty": {"type": "number"}, "scope_penalty": {"type": "number"}}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["applicability_floor", "high_confidence", "minimum_margin", "ambiguity_window", "supporting_floor"], "properties": {"applicability_floor": {"type": "number", "minimum": 0, "maximum": 1}, "high_confidence": {"type": "number", "minimum": 0, "maximum": 1}, "minimum_margin": {"type": "number", "minimum": 0, "maximum": 1}, "ambiguity_window": {"type": "number", "minimum": 0, "maximum": 1}, "supporting_floor": {"type": "number", "minimum": 0, "maximum": 1}}},
    "extensions": {"type": "object", "additionalProperties": false, "required": ["vector", "llm"], "properties": {"vector": {"const": "disabled"}, "llm": {"const": "disabled"}}}
  }
}
