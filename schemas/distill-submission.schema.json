{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/distill-submission.schema.json",
  "title": "Distill run submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["coverage", "findings"],
  "properties": {
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource", "status", "reason"],
        "properties": {
          "resource": {"type": "string", "minLength": 1},
          "status": {"enum": ["analyzed", "consulted", "ruled_out_with_reason", "deferred", "unreadable", "out_of_scope"]},
          "reason": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean", "default": false}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_key", "status", "what", "vocabulary", "evidence"],
        "properties": {
          "stable_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "status": {"enum": ["active", "removed", "superseded"]},
          "what": {"type": "string", "minLength": 1},
          "vocabulary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision", "run_id", "package_digest", "path", "locator", "digest"],
              "properties": {
                "revision": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "value", "content_digest"],
                  "properties": {
                    "kind": {"enum": ["git-commit", "git-tree", "filesystem-snapshot", "content-digest", "declared-version"]},
                    "value": {"type": "string", "minLength": 1},
                    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
                  }
                },
                "run_id": {"type": "string", "minLength": 1},
                "package_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "path": {"type": "string", "minLength": 1},
                "locator": {"type": "string", "minLength": 1},
                "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          },
          "supersedes_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "superseded_by_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "subject", "observation_ids", "verdict", "tradeoffs", "based_on"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "subject": {"type": "string", "minLength": 1},
          "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "verdict": {"enum": ["convergent", "complementary", "conflicting", "same-mechanism-different-scope", "probable-duplicate", "insufficient-evidence"]},
          "tradeoffs": {"type": "string"},
          "based_on": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value", "content_digest"],
              "properties": {
                "kind": {"type": "string", "minLength": 1},
                "value": {"type": "string", "minLength": 1},
                "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_key", "skill_id", "recommendation", "observation_ids", "category", "priority", "rationale"],
        "properties": {
          "stable_key": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 96},
          "skill_id": {"type": "string", "minLength": 1},
          "recommendation": {"type": "string", "minLength": 1},
          "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "comparison_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "category": {"type": "string", "minLength": 1},
          "priority": {"enum": ["low", "medium", "high", "critical"]},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "outstanding_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "question"],
        "properties": {
          "kind": {"enum": ["ambiguity", "coverage"]},
          "resource": {"type": "string"},
          "question": {"type": "string", "minLength": 1}
        }
      }
    },
    "resolution": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "maxLength": 512}
  }
}
