{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/insight-application.schema.json",
  "title": "Insight application preview input",
  "type": "object",
  "additionalProperties": false,
  "required": ["changes", "mappings"],
  "properties": {
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "contents"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "contents": {"type": "string", "minLength": 1}
        }
      }
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "artifact_path", "concept"],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "artifact_path": {"type": "string", "minLength": 1},
          "concept": {"type": "string", "minLength": 1}
        }
      }
    },
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
