{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/incorporation-outcome.schema.json",
  "title": "Explicit incorporation outcome",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "evidence", "note"],
  "properties": {
    "state": {"enum": ["confirmed", "adjusted", "ineffective"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "note": {"type": "string", "minLength": 1},
    "supersedes": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 512}
  }
}
