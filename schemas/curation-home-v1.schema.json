{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillhub.local/schemas/curation-home-v1.schema.json",
  "title": "Skill Hub curation home v1",
  "description": "Versioned JSON contract emitted by skillhub status --json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "summary", "items", "suggested_actions", "warnings", "error", "workspace", "actions", "categories", "home_summary"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"type": "string", "enum": ["ok", "ready", "action_required", "applied", "recovery_required", "partial_failure", "error"]},
    "summary": {"type": "string", "minLength": 1},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "suggested_actions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/action"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/error"}]},
    "workspace": {"$ref": "#/$defs/workspace"},
    "actions": {"type": "array", "items": {"$ref": "#/$defs/actionItem"}},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "home_summary": {"$ref": "#/$defs/homeSummary"}
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "summary", "impact"],
      "properties": {"id": {"type": "string"}, "summary": {"type": "string"}, "impact": {"type": "string"}}
    },
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "command"],
      "properties": {"label": {"type": "string"}, "command": {"type": "string"}, "cli": {"type": "string"}, "requires_confirmation": {"type": "boolean"}}
    },
    "warning": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "summary"],
      "properties": {"code": {"type": "string"}, "summary": {"type": "string"}}
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "render"],
      "properties": {
        "code": {"type": "string"},
        "retryable": {"type": "boolean"},
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["ERROR", "WHY", "FIX"],
          "properties": {"ERROR": {"type": "string"}, "WHY": {"type": "string"}, "FIX": {"type": "string"}}
        }
      }
    },
    "workspace": {
      "type": "object", "additionalProperties": false,
      "required": ["health", "index", "git_dirty", "git_configured", "recovery_pending"],
      "properties": {
        "health": {"type": "string"}, "index": {"type": "string"},
        "git_dirty": {"type": "boolean"}, "git_configured": {"type": "boolean"}, "recovery_pending": {"type": "boolean"}
      }
    },
    "actionItem": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "priority", "summary", "command"],
      "properties": {
        "kind": {"type": "string"}, "id": {"type": "string"}, "count": {"type": "integer"},
        "priority": {"type": "integer"}, "summary": {"type": "string"}, "command": {"type": "string"}
      }
    },
    "category": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "count", "availability"],
      "properties": {
        "kind": {"type": "string"}, "count": {"type": "integer"},
        "availability": {"type": "string", "enum": ["available", "not_configured", "unavailable"]}
      }
    },
    "homeSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["active_skills", "watching_sources", "failed_or_interrupted_runs", "pending_insights", "pending_high_value_insights", "attention_items", "invalid_workspaces", "recovery_items", "optional_items", "sources_due", "unavailable_sources", "upstream_updates"],
      "properties": {
        "active_skills": {"type": "integer"}, "watching_sources": {"type": "integer"},
        "failed_or_interrupted_runs": {"type": "integer"}, "pending_insights": {"type": "integer"},
        "pending_high_value_insights": {"type": "integer"}, "attention_items": {"type": "integer"},
        "invalid_workspaces": {"type": "integer"}, "recovery_items": {"type": "integer"},
        "optional_items": {"type": "integer"}, "sources_due": {"type": "integer"},
        "unavailable_sources": {"type": "integer"},
        "upstream_updates": {"type": "integer"}
      }
    }
  }
}
