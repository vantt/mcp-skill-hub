=== .codex/config.toml
[mcp_servers.skillhub]
command = "<BINARY>"
args = ["mcp", "serve", "--workspace", "<WORKSPACE>"]
cwd = "<WORKSPACE>"
enabled = true

[sandbox_workspace_write]
writable_roots = ["<WORKSPACE>/runtime/cache/skills", "<WORKSPACE>/runtime/envs", "<WORKSPACE>/runtime/config"]
